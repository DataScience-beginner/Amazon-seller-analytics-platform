# Backend
APP_NAME=SellerOS
ENVIRONMENT=local
DATABASE_URL=sqlite:///./selleros.db
CORS_ORIGINS=["http://localhost:5173"]
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_WORKBOOK_UNCOMPRESSED_BYTES=209715200
MAX_WORKBOOK_SHEETS=20
MAX_WORKBOOK_ROWS=100000
MAX_WORKBOOK_COLUMNS=500
IMPORT_PREVIEW_ROWS=5

# Local first-use only. Set false before any shared or public deployment.
ALLOW_UNAUTHENTICATED_WORKSPACE_BOOTSTRAP=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000
